# =========================================================================
# openclob agent configuration. Copy to .env and fill in.
# =========================================================================

# ---- Runtime mode ----
# One of: backtest | paper | dryrun | live
AGENT_MODE=paper

# Bankroll in USD-equivalent. Hard-capped by phase regardless.
AGENT_BANKROLL=50

# Cycle period for --loop in seconds.
AGENT_CYCLE_SECONDS=1200

# Comma-separated list of allowed categories. Use 'all' to allow any.
AGENT_CATEGORIES=geopolitics,world,politics

# Hard per-market position cap in USD.
AGENT_PER_MARKET_CAP=2

# Max simultaneous open positions.
AGENT_MAX_POSITIONS=8

# Daily loss circuit-breaker (fraction of bankroll). 0.20 = 20%.
AGENT_DAILY_LOSS_CAP=0.20

# ---- LLM (AWS Bedrock) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only if using temporary credentials
AWS_SESSION_TOKEN=

# Model selector. Examples:
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   us.anthropic.claude-haiku-4-5-20251001-v1:0
#   us.anthropic.claude-opus-4-7-20251201-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Cheap model used for ambiguity-check pre-filter. Falls back to BEDROCK_MODEL_ID if unset.
BEDROCK_MODEL_ID_CHEAP=us.amazon.nova-lite-v1:0

# Per-decision soft cap (USD) and per-day hard cap (USD).
LLM_PER_DECISION_USD_CAP=0.05
LLM_PER_DAY_USD_CAP=5.00

# Approximate $/1M tokens for the configured model. Used for budget accounting.
# Defaults match Claude Sonnet 4.5 list price; override if you switch models.
LLM_INPUT_USD_PER_MTOK=0.80   # Amazon Nova Pro input
LLM_OUTPUT_USD_PER_MTOK=3.20  # Amazon Nova Pro output

# ---- Search (Exa) ----
# Exa is the only supported provider. Its per-result `publishedDate` is what
# `temporal_guard` enforces the reasoning cutoff against, so a provider without
# publication dates cannot be substituted without breaking the leakage gate.
SEARCH_PROVIDER=exa
EXA_API_KEY=
SEARCH_MAX_RESULTS=8

# ---- Manifold (paper trading) ----
MANIFOLD_API_KEY=
MANIFOLD_BASE_URL=https://api.manifold.markets

# ---- Polymarket (live) ----
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Signature type: 0 = EOA, 1 = poly-proxy, 2 = poly-gnosis-safe
POLYMARKET_SIG_TYPE=0
POLYMARKET_CHAIN_ID=137

# ---- Solana (on-chain settlement) ----
# The reasoning-trace hash is anchored via the SPL Memo program; a symbolic SPL
# token transfer settles each decision. Devnet by default.
SOLANA_ENABLED=true
SOLANA_CLUSTER=devnet
# Public devnet RPC. Override with a Helius endpoint for real throughput.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_EXPLORER_BASE=https://explorer.solana.com
# Path to the agent's Solana keypair JSON (e.g. ~/.config/solana/id.json).
# Fund it from https://faucet.solana.com (devnet SOL).
SOLANA_KEYPAIR_PATH=
# Settle destination; defaults to the agent's own pubkey if unset.
SOLANA_TREASURY_ADDRESS=
SOLANA_MEMO_PROGRAM=MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr
SOLANA_SETTLE_USDC=0.01
# Circle USDC-devnet mint — the settle asset until $BBC is minted.
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# $BBC is NOT launched yet. Leave empty until the ClawPump mint address exists.
BBC_MINT_ADDRESS=

# ---- Web (Next.js, NEXT_PUBLIC_* are inlined at build time) ----
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Override with a Helius RPC URL if you have one.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Leave empty until $BBC is minted — the UI degrades gracefully without it.
NEXT_PUBLIC_BBC_MINT=
# Treasury the browser-signed settle transfers to; defaults to a self-send.
NEXT_PUBLIC_SOLANA_TREASURY=

# ---- GraphRAG (openmind) ----
GRAPHRAG_ENABLED=true
GRAPHRAG_MAX_NODES=30

# ---- Web (openmind frontend) ----
WEB_ORIGIN=http://localhost:3000

# ---- Storage / observability (Supabase/Postgres) ----
# Apply agent/store/schema.sql via the Supabase SQL editor once per project; it owns the
# schema and a publishable key cannot run DDL.
SUPABASE_URL=https://<project-ref>.supabase.co
# Anon/publishable key. Safe for client-side use; RLS gates what it can touch.
SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only — bypasses RLS. NEVER expose this as a NEXT_PUBLIC_* variable
# or ship it to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Note: db.<project-ref>.supabase.co is IPv6-only. If your host/network is IPv4-only (many
# CI runners and some PaaS containers are), direct connections will fail to resolve/connect;
# use the connection pooler instead — host aws-0-<region>.pooler.supabase.com, user
# postgres.<project-ref>. This cost real debugging time; don't rediscover it.
AGENT_LOG_PATH=logs/agent.jsonl
AGENT_LOG_LEVEL=INFO

# Optional webhook (Slack-compatible) for alerts.
ALERT_WEBHOOK_URL=
